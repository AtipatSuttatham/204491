# คัดลอกไฟล์นี้เป็น .env แล้วปรับค่าตามเครื่องของคุณ
#   cp .env.example .env

# Django
# หมายเหตุ: DJANGO_SETTINGS_MODULE ตั้งจาก manage.py/wsgi/asgi (default = config.settings.dev)
# ถ้าจะ override ให้ตั้งเป็น environment variable จริง ไม่ใช่ในไฟล์นี้ (โหลดไม่ทัน)
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (ตรงกับ docker-compose.yml ที่ root ของ repo)
# host port = 5433 เพราะเครื่อง dev มี PostgreSQL 17 native ครอง 5432 อยู่แล้ว
DATABASE_URL=postgres://lms:lms@localhost:5433/lms

# CORS — origin ของ frontend (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (dev = console backend; ยังไม่เลือก provider สำหรับ production)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@lms.local

# URL ของ frontend สำหรับลิงก์ในอีเมล (verify email ฯลฯ)
FRONTEND_BASE_URL=http://localhost:5173

# JWT lifetime (นาที / วัน)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
